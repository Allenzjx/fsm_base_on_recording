    "rear_left_bot": "LEG",
    "rear_right_bot": "LEG",
    "front_left_wheel": "WHEEL",
    "front_right_wheel": "WHEEL",
    "rear_left_wheel": "WHEEL",
    "rear_right_wheel": "WHEEL"
